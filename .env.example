# Example Environment Configuration
# Copy this file to .env and fill with your actual values
# DO NOT commit .env to version control

# ── Anthropic (preferido se definido, substitui Copilot) ────────────────────
ANTHROPIC_API_KEY=
# ── GitHub Copilot (fallback) ────────────────────────────────────────────────
GITHUB_TOKEN=
# Modelos por tier (defaults já corretos no settings.py)
DEFAULT_MODEL=claude-sonnet-4-6
TIER_MODEL_MAP={"T1":"claude-sonnet-4-6","T2":"claude-haiku-4-5-20251001","T3":"claude-haiku-4-5-20251001"}
TIER_TURNS_MAP={"T1":40,"T2":12,"T3":5}

# ── Databricks (opcional, para MCP) ─────────────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_CLUSTER_ID=

# ── Microsoft Fabric (opcional, para MCP) ───────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_LAKEHOUSE_NAME=
# Modo de autenticação: sp (Service Principal) | interactive (browser/DefaultAzureCredential) | device (device flow)
FABRIC_AUTH_MODE=

# ── QA Orchestrator ─────────────────────────────────────────────────────────
QA_ENABLED=true
QA_MAX_ROUNDS=3
QA_SCORE_THRESHOLD=0.7

# ── Operacional ─────────────────────────────────────────────────────────────
MAX_BUDGET_TOKENS=500000
CONSOLE_LOG_LEVEL=WARNING
OUTPUT_MAX_CHARS=0
LLM_MAX_TOKENS=64000
SESSION_MAX_RESUME_TURNS=10

# ── GitHub PAT (opcional, para integração com fabric-ci-cd) ────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Repositório local (para filesystem + git tools) ──────────────────────────
LOCAL_REPO_PATH=